# ═══════════════════════════════════════════════════════════
# NIGHTFANG — Environment Configuration
# Copy this file to .env and populate with your credentials.
# ═══════════════════════════════════════════════════════════

# Primary Telegram Bot HITL Credentials (Sole Communication Channel)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="987654321"

# Threat Intelligence & OSINT APIs (Optional)
SHODAN_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""

# Cloud Assessment Credentials (if greybox/whitebox in scope)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Swarm Operational Flags
NIGHTFANG_TOKEN_EFFICIENCY="false"   # true = start in Caveman / Terse mode
NIGHTFANG_MAX_CONCURRENT_AGENTS="7"
NIGHTFANG_LOG_LEVEL="INFO"
