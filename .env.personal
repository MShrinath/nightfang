# OPENCLAW / AEGIS — Personal Environment Variables
# Copy this to .env.personal and fill in YOUR values
# This file is loaded AFTER .env, so it can override framework settings
# NEVER commit this file to version control!

# ─────────────────────────────────────────────────────
# TELEGRAM (Required for HITL)
# ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─────────────────────────────────────────────────────
# OPERATOR IDENTITY
# ─────────────────────────────────────────────────────
HERMES_OPERATOR=@SecurityLead

# ─────────────────────────────────────────────────────
# ENGAGEMENT CREDENTIALS (Greybox/Whitebox)
# Reference these in config/personal_engagement.yaml
# ─────────────────────────────────────────────────────

# Standard test user
TEST_USER_STANDARD=test_user_qa
TEST_PASS_STANDARD=Password123!
TEST_TOTP_STANDARD=JBSWY3DPEHPK3PXP

# Premium test user
TEST_USER_PREMIUM=premium_tester
TEST_PASS_PREMIUM=PremiumPass456!

# API Consumer
TEST_API_KEY_CONSUMER=ak_live_xxxxxxxxxxxxx
TEST_API_SECRET_CONSUMER=sk_live_xxxxxxxxxxxxx

# GraphQL JWT
TEST_GRAPHQL_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Assistant Session
TEST_AI_SESSION_TOKEN=sess_xxxxxxxxxxxxx

# SSH Key Path (for internal network testing)
TARGETCORP_SSH_KEY_PATH=~/.ssh/pentest_id_rsa

# ─────────────────────────────────────────────────────
# THREAT INTEL API KEYS (Optional)
# ─────────────────────────────────────────────────────
SHODAN_API_KEY=your_shodan_key
CENSYS_API_ID=your_censys_id
CENSYS_API_SECRET=your_censys_secret
VT_API_KEY=your_virustotal_key

# ─────────────────────────────────────────────────────
# CLOUD PROVIDER CREDENTIALS (Optional)
# ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=us-east-1

AZURE_SUB_IDS=sub-xxxxxxxx,sub-yyyyyyyy
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

GCP_PROJECT_IDS=project-1,project-2
GOOGLE_APPLICATION_CREDENTIALS=~/gcp-credentials.json

# ─────────────────────────────────────────────────────
# GIT / CODE REPOS (Optional)
# ─────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
GITLAB_TOKEN=glpat_xxxxxxxxxxxxx

# ─────────────────────────────────────────────────────
# PROXY / EGRESS (Optional)
# ─────────────────────────────────────────────────────
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1,*.internal

# ─────────────────────────────────────────────────────
# AEGIS PERSONAL SETTINGS
# ─────────────────────────────────────────────────────
HERMES_TOKEN_EFFICIENCY=false
HERMES_MAX_CONCURRENT_AGENTS=7

# Custom paths (override defaults)
# WORDLISTS_DIR=~/wordlists
# NUCLEI_TEMPLATES_DIR=~/nuclei-templates
# PROMPTS_DIR=~/prompts